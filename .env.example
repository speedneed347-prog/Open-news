# GEMINI_API_KEY: Required for server-side Gemini AI intelligence routes (/api/ai/*).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI_PROVIDER: Interchangeable AI provider selector (default: gemini)
AI_PROVIDER="gemini"

# APP_URL: Canonical base URL where ALL INFORMATION HUB is hosted (used for sitemap/robots/SEO).
APP_URL="MY_APP_URL"

# PORT: Express server listen port (default: 3000)
PORT="3000"

# OPTIONAL EXTERNAL NEWS API KEYS (keep strictly server-side if enabling authorized API sources)
AUTHORIZED_NEWS_API_KEY=""
