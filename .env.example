# AI_PROVIDER: 100% Open-Source AI provider selector
# Supported values: auto | local | ollama | huggingface | openai_compatible
# Default "auto" uses Ollama/Hugging Face/vLLM when configured, or falls back to
# the built-in zero-key Open-Source Local NLP Engine.
AI_PROVIDER="auto"

# Option A — Self-hosted Ollama (Llama 3, Mistral, Qwen, Gemma)
OLLAMA_BASE_URL=""

# Option B — Hugging Face Inference Router (Open-Weights models like Llama 3.3 / Qwen 2.5 / Mistral)
HF_TOKEN=""

# Option C — Any self-hosted or open-weights OpenAI-compatible server (vLLM, llama.cpp, LocalAI)
OPENSOURCE_AI_BASE_URL=""
OPENSOURCE_AI_MODEL="meta-llama/Llama-3.3-70B-Instruct"
OPENSOURCE_AI_API_KEY=""

# Optional — Self-hosted LibreTranslate open-source translation server
LIBRETRANSLATE_URL=""
LIBRETRANSLATE_API_KEY=""

# APP_URL: Canonical base URL where ALL INFORMATION HUB is hosted (used for sitemap/robots/SEO).
APP_URL="MY_APP_URL"

# PORT: Express server listen port (default: 3000)
PORT="3000"

# OPTIONAL EXTERNAL NEWS API KEYS (keep strictly server-side if enabling authorized API sources)
AUTHORIZED_NEWS_API_KEY=""
